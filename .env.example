# Copy this file to .env and fill in real values. Never commit .env.

# Neon Postgres — use the pooled connection string (endpoint ends in "-pooler")
# to avoid the low concurrent-connection limit on the direct endpoint.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Seeded single admin account (used by prisma/seed.ts to create the AdminUser row)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-before-seeding"

# Cloudinary (free tier) — used for signed image uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (free tier) — used to email-notify on contact form submissions
RESEND_API_KEY=""
CONTACT_NOTIFICATION_EMAIL="you@example.com"
