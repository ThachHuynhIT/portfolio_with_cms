# Copy this file to .env and fill in real values. Never commit .env.

# Neon Postgres — use the pooled connection string (endpoint ends in "-pooler")
# to avoid the low concurrent-connection limit on the direct endpoint.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Dev tooling only (Phase 3 — MCP + AI Development Workflow). SELECT-only Postgres role
# (see docs/ROADMAP.md Phase 3), used exclusively by a local MCP server — never read by
# application code. Not required for the app to build/run.
MCP_POSTGRES_READONLY_URL="postgresql://mcp_readonly:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Seeded single admin account (used by prisma/seed.ts to create the AdminUser row)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-before-seeding"

# Cloudinary (free tier) — used for signed image uploads (Phase 11, src/lib/admin/cloudinary.ts).
# Also reused by a local Cloudinary MCP server (dev tooling only — see docs/LESSONS.md), which
# reads these same three values to build its own CLOUDINARY_URL.
# No upload preset needed: format is enforced via a directly signed `allowed_formats` param, and
# max size via a post-upload bytes check + destroy in src/lib/admin/cloudinary.ts — an upload
# preset's allowed_formats/max_file_size settings were verified NOT to be enforced for signed
# uploads on this account (see docs/LESSONS.md).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (free tier) — used to email-notify on contact form submissions
RESEND_API_KEY=""
CONTACT_NOTIFICATION_EMAIL="you@example.com"

# Dev tooling only — used by a local Context7 MCP server (up-to-date library docs,
# see docs/LESSONS.md). Optional: without it Context7 still works, just at a lower
# anonymous rate limit. Never read by application code.
CONTEXT7_API_KEY=""
