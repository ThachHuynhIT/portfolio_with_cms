// Prisma schema for the portfolio CMS.
// See the architecture plan for the reasoning behind this data model.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum ExperienceType {
  WORK
  EDUCATION
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Singleton row (always id = "singleton") holding sitewide copy/config.
model SiteSettings {
  id                  String   @id @default("singleton")
  siteName            String   @default("")
  tagline             String   @default("")
  heroHeadline        String   @default("")
  heroSubtext         String   @default("")
  heroImageUrl        String?
  bio                 String   @default("")
  avatarUrl           String?
  resumeFileUrl       String?
  contactEmail        String?
  socialLinks         Json     @default("{}")
  defaultSeoTitle     String   @default("")
  defaultSeoDescription String @default("")
  ogImageUrl          String?
  updatedAt           DateTime @updatedAt
}

model Skill {
  id        String   @id @default(cuid())
  name      String
  category  String
  iconUrl   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExperienceEntry {
  id           String         @id @default(cuid())
  type         ExperienceType
  title        String
  organization String
  location     String?
  startDate    DateTime
  endDate      DateTime?
  description  String         @default("")
  order        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Project {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  summary         String        @default("")
  description     String        @default("")
  coverImageUrl   String?
  galleryUrls     String[]      @default([])
  techTags        String[]      @default([])
  liveUrl         String?
  repoUrl         String?
  order           Int           @default(0)
  featured        Boolean       @default(false)
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt])
}

model BlogPost {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String        @default("")
  content        String        @default("")
  coverImageUrl  String?
  tags           String[]      @default([])
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Testimonial {
  id              String        @id @default(cuid())
  authorName      String
  authorRole      String?
  authorAvatarUrl String?
  quote           String
  order           Int           @default(0)
  status          ContentStatus @default(DRAFT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
